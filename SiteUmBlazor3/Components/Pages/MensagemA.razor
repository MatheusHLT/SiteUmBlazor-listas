@page "/mensagem"
@rendermode InteractiveServer

<h1>Mensagem</h1>

<button @onclick="AlternarVisibilidade">@(exibirMensagem ? "Ocultar Mensagem" : "Exibir Mensagem")</button>

@if (exibirMensagem)
{
<p>Bem-vindo ao desenvolvimento web com .NET 10!</p>
}

@code {
    private Boolean exibirMensagem = false;

    private void AlternarVisibilidade() {
        exibirMensagem = !exibirMensagem;
    }
}

